# ============================================================
# LT SUPERCOM — ENVIRONMENT CONFIGURATION
# ============================================================

# Database (PostgreSQL)
# e.g., postgresql://username:password@localhost:5432/lt_supercom
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/lt_supercom

# Authentication & Session Security (Server-Only)
# Generate a strong 32+ character random string for production
SESSION_SECRET=lt_supercom_secure_session_secret_replace_in_production_key_32bytes
SESSION_MAX_AGE_DAYS=7

# Node Environment
NODE_ENV=development
PORT=3000

# File Storage Configuration (Optional S3 / Local Provider)
# Set to 'local' for local disk or 's3' for AWS S3 / Cloudflare R2 / MinIO
STORAGE_PROVIDER=local
STORAGE_LOCAL_DIR=./uploads
# S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_BUCKET_NAME=lt-supercom-files
# S3_REGION=auto

# Email / Notification Provider (Optional - Defaults to console logger in dev)
# EMAIL_PROVIDER=smtp
# SMTP_HOST=smtp.sendgrid.net
# SMTP_PORT=587
# SMTP_USER=apikey
# SMTP_PASS=
# EMAIL_FROM=noreply@ltsupercom.com

# AI Talent Engine Provider (Optional - Defaults to built-in rule/semantic matcher in dev)
# AI_PROVIDER=anthropic # or 'openai' or 'gemini'
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GEMINI_API_KEY=
